# PayPal Sandbox credentials - obtain from https://developer.paypal.com/
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# NVIDIA API key for the Commerce Agent (must be set in .env.local, never committed)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# --- CommercePilot application (Task 10 CP2) — non-secret values only ---
# Store database file path. Relative to the working directory. '..' segments rejected.
# Default: ./data/commerce.db
COMMERCEPILOT_DB_PATH=./data/commerce.db
# Canonical HTTPS public base URL used ONLY to derive the PayPal buyer-redirect URLs.
# HTTPS-only (no localhost exception). No query strings or fragments.
# Default: https://commercepilot.toolspacehub.com
COMMERCEPILOT_PUBLIC_BASE_URL=https://commercepilot.toolspacehub.com
# Derived (not configurable): {COMMERCEPILOT_PUBLIC_BASE_URL}/paypal/return and /paypal/cancel
